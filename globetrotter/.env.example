# Local dev (docker compose up -d). For Neon, replace both:
#   DATABASE_URL -> pooled host (contains "-pooler")
#   DIRECT_URL   -> direct host (no "-pooler"), used only by prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/globetrotter?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/globetrotter?schema=public"

# openssl rand -base64 32
SESSION_SECRET="GENERATE_WITH_openssl_rand_base64_32"

# ── Maps (optional) ──────────────────────────────────────────────────────
# Leave unset and the city map falls back to plotting the stored coordinates
# itself. Nothing breaks without a key.
#
# MAP_PROVIDER: "maptiler" (default) or "mapbox".
# MAP_API_KEY:  deliberately NOT prefixed NEXT_PUBLIC_. Pages request maps
#               through /api/map/static, which injects the key server-side,
#               so it never reaches the browser.
MAP_PROVIDER="maptiler"
MAP_API_KEY=""
