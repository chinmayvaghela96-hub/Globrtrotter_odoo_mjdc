# Local dev (docker compose up -d). For Neon, replace both:
#   DATABASE_URL -> pooled host (contains "-pooler")
#   DIRECT_URL   -> direct host (no "-pooler"), used only by prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/globetrotter?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/globetrotter?schema=public"

# openssl rand -base64 32
SESSION_SECRET="GENERATE_WITH_openssl_rand_base64_32"

# ── Maps (optional) ──────────────────────────────────────────────────────
# Leave unset and the city map falls back to plotting the stored coordinates
# itself. Nothing breaks without a key.
#
# MAP_PROVIDER: "maptiler" (default) or "mapbox".
# MAP_API_KEY:  deliberately NOT prefixed NEXT_PUBLIC_. Pages request maps
#               through /api/map/static, which injects the key server-side,
#               so it never reaches the browser.
MAP_PROVIDER="maptiler"
MAP_API_KEY=""

# ── Travel data providers (all optional) ─────────────────────────────────
# Every adapter falls back to a local model when unset, so the app always
# produces a sensible number. `{base}`, `{from}`, `{to}`, `{city}`,
# `{nights}` and `{key}` are substituted into the URL.
#
# Rates: any vendor returning { "rates": { "INR": 91.2, ... } } works —
# exchangerate.host, open.er-api.com, Fixer, Frankfurter, OpenExchangeRates.
CURRENCY_API_URL=""
CURRENCY_API_KEY=""

# Expect { "options": [{ mode, cost, durationMin, note }] }
TRANSPORT_API_URL=""
TRANSPORT_API_KEY=""

# Expect { "estimates": [{ tier, perNight, total }] }
STAY_API_URL=""
STAY_API_KEY=""

# ── Copernicus Data Space (optional) ─────────────────────────────────────
# Sentinel-2 imagery for the "From space" panel on a city page. OAuth2
# client credentials; the secret stays server-side behind /api/satellite.
# Unset, the panel is simply not rendered.
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
