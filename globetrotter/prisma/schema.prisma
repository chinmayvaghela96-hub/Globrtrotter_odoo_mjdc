generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // migrations bypass the pooler (Neon)
}

enum Role {
  USER
  ADMIN
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  ADVENTURE
  CULTURE
  NIGHTLIFE
  NATURE
  SHOPPING
  RELAXATION
}

enum ExpenseCategory {
  TRANSPORT
  STAY
  ACTIVITY
  MEALS
  OTHER
}

// ── people ─────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  photoUrl     String?
  language     String   @default("en")
  currency     String   @default("INR")
  role         Role     @default(USER) // never writable from a form
  createdAt    DateTime @default(now())

  trips       Trip[]
  savedCities SavedCity[]
}

// ── reference catalogue: seeded, no write path in the app ──────────────
model City {
  id         String @id @default(cuid())
  name       String
  country    String
  region     String
  latitude   Float
  longitude  Float
  costIndex  Int // 1..100, daily-spend proxy
  popularity Int // 1..100, drives "recommended"
  imageUrl   String

  stops      Stop[]
  activities Activity[]
  savedBy    SavedCity[]

  @@unique([name, country]) // natural key — the seed upserts on it
  @@index([country])
  @@index([popularity])
}

model Activity {
  id          String           @id @default(cuid())
  cityId      String
  city        City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name        String
  description String
  category    ActivityCategory
  cost        Decimal          @db.Decimal(10, 2)
  durationMin Int
  imageUrl    String?

  tripActivities TripActivity[]

  @@unique([cityId, name])
  @@index([cityId, category])
}

// ── the trip graph ─────────────────────────────────────────────────────
model Trip {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   DateTime @db.Date // @db.Date — no time, no timezone
  endDate     DateTime @db.Date
  coverUrl    String?
  currency    String   @default("INR")
  budgetCap   Decimal? @db.Decimal(12, 2)
  isPublic    Boolean  @default(false)
  shareSlug   String?  @unique // nulled when sharing is revoked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // self-relation: provenance for "Copy Trip"
  copiedFromId String?
  copiedFrom   Trip?   @relation("TripCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       Trip[]  @relation("TripCopies")

  stops    Stop[]
  expenses Expense[]

  @@index([userId, startDate])
}

model Stop {
  id            String   @id @default(cuid())
  tripId        String
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  cityId        String
  city          City     @relation(fields: [cityId], references: [id]) // Restrict: a seeded city cannot vanish under a trip
  orderIndex    Int
  arrivalDate   DateTime @db.Date
  departureDate DateTime @db.Date
  // Always in the trip's currency. Every budget query sums these, so their
  // meaning must never change.
  transportCost Decimal  @default(0) @db.Decimal(10, 2)
  stayCost      Decimal  @default(0) @db.Decimal(10, 2)
  notes         String?

  // What the traveller actually paid, before conversion. Null means the cost
  // was entered in the trip currency and no conversion happened — which is
  // true of every row that existed before this was added.
  originalTransportCost Decimal?  @db.Decimal(12, 2)
  originalStayCost      Decimal?  @db.Decimal(12, 2)
  originalCurrency      String?
  // originalCurrency -> trip currency, and when that rate was taken. Stored
  // rather than looked up live, so a saved budget cannot shift under the
  // traveller when the market moves.
  fxRate                Decimal?  @db.Decimal(18, 8)
  fxRateAt              DateTime?

  activities TripActivity[]

  // @@index, NOT @@unique. Postgres validates a unique constraint per
  // statement, so renumbering 0..n-1 inside a transaction trips it on the
  // intermediate state, and Prisma cannot declare the constraint
  // DEFERRABLE. The invariant is held by the transaction in
  // src/actions/stop.ts and proved by tests/reorder.test.ts.
  @@index([tripId, orderIndex])
}

model TripActivity {
  id            String    @id @default(cuid())
  stopId        String
  stop          Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activityId    String? // null = the user's own custom activity
  activity      Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  customName    String? // survives a deleted catalogue entry
  scheduledDate DateTime  @db.Date
  startTime     String? // "09:30" as text — keeps timezones out of it
  // cost is a snapshot, not a live lookup: a catalogue price change must
  // never silently rewrite a budget the user already saw.
  cost          Decimal   @db.Decimal(10, 2)
  durationMin   Int       @default(60)
  orderIndex    Int
  notes         String?

  // See Stop: `cost` stays in the trip currency, these record the original.
  originalCost     Decimal?  @db.Decimal(12, 2)
  originalCurrency String?
  fxRate           Decimal?  @db.Decimal(18, 8)
  fxRateAt         DateTime?

  @@index([stopId, scheduledDate])
}

model Expense {
  id       String          @id @default(cuid())
  tripId   String
  trip     Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category ExpenseCategory
  label    String
  amount   Decimal         @db.Decimal(10, 2)
  date     DateTime        @db.Date

  // See Stop: `amount` stays in the trip currency, these record the original.
  originalAmount   Decimal?  @db.Decimal(12, 2)
  originalCurrency String?
  fxRate           Decimal?  @db.Decimal(18, 8)
  fxRateAt         DateTime?

  @@index([tripId, date])
}

model SavedCity {
  userId  String
  cityId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@id([userId, cityId]) // composite PK, no surrogate id needed
}
